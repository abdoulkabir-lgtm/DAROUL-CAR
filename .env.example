# Base PostgreSQL (fournie par Railway : variable DATABASE_URL du service Postgres)
DATABASE_URI=postgres://postgres:postgres@localhost:5432/daroul
# Clé secrète Payload : une longue chaîne aléatoire (ex. openssl rand -hex 32)
PAYLOAD_SECRET=change-moi
# URL publique du site (sans / final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Numéro WhatsApp DAROUL CAR, format international sans + ni espaces
NEXT_PUBLIC_WHATSAPP=2250778483076
# Dossier de stockage des photos/vidéos (monter un volume Railway ici en production)
MEDIA_DIR=./media

# Compte admin créé par « npm run seed » (changez le mot de passe ensuite)
ADMIN_EMAIL=admin@daroulcar.ci
ADMIN_PASSWORD=
